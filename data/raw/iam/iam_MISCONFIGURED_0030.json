{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM Role for backend1421",
  "Resources": {
    "Rolebackend1421": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "role-backend1421",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::999999999999:root"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "policy-backend1421",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "*",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  }
}