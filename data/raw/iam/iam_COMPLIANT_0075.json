{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM Role for frontend5087",
  "Resources": {
    "Rolefrontend5087": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "role-frontend5087",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "policy-frontend5087",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": "arn:aws:s3:::my-bucket-frontend5087/*",
                  "Condition": {
                    "StringEquals": {
                      "s3:prefix": "uploads/"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}